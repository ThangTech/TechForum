{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Jwt": {
    "Issuer": "TechForum.Api",
    "Audience": "TechForum.Web",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "ShortRefreshTokenDays": 1
  },
  "VoteLimits": {
    "MinAccountAgeDays": 3,
    "DownvoteMinAccountAgeDays": 7,
    "DownvoteMinReputation": 50,
    "PerMinute": 30,
    "PerDay": 200
  },
  "Media": {
    "StoragePath": "App_Data/uploads",
    "RequestPath": "/media",
    "MaxImageBytes": 5242880,
    "MaxAvatarBytes": 2097152,
    "MaxVideoBytes": 52428800,
    "OrphanRetentionHours": 24,
    "CleanupIntervalMinutes": 60,
    "CleanupBatchSize": 100
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "IncludeScopes": true
    }
  },
  "AllowedHosts": "*"
}
