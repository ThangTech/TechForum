# Cấu hình cho docker-compose.yml. Chép file này thành .env (đã có trong .gitignore, không đẩy lên Git) rồi điền.

# ---------- Bắt buộc ----------
# Mật khẩu tài khoản sa của SQL Server trong container. SQL Server đòi ít nhất 8 ký tự, có chữ hoa, chữ thường,
# chữ số và ký tự đặc biệt; nếu không đủ mạnh, container DB sẽ dừng ngay khi khởi động.
DB_PASSWORD=

# Khoá ký JWT, ít nhất 32 ký tự ngẫu nhiên. Tạo một khoá bằng PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SIGNING_KEY=

# ---------- Tuỳ chọn ----------
# Cổng mở trang web trên máy (http://localhost:8088) và cổng xem DB bằng SSMS (localhost,14333).
WEB_PORT=8088
DB_PORT=14333

# Thêm chuyên mục, thẻ và vài bài mẫu khi DB còn trống.
SEED_DEMO_DATA=true

# Tải ảnh/video lên Cloudinary (lấy trong trang Dashboard của Cloudinary). Để trống thì không tải tệp lên được.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email quên mật khẩu (SMTP). Để trống thì chức năng này báo chưa sẵn sàng.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
# Địa chỉ trang web mà link trong email trỏ tới.
PUBLIC_URL=http://localhost:8088

# Danh sách từ cấm thật (file chỉ có trên máy, không đẩy lên Git). Để trống thì dùng file mẫu trong repo.
# BANNED_WORDS_FILE=./backend/Data/Seed/banned-words.txt

# Key giấy phép Froala (nếu có). Để trống thì trình soạn thảo chạy chế độ đánh giá.
VITE_FROALA_KEY=

# Phiên bản image khi tải từ GitHub Container Registry (docker compose pull): latest hoặc mã commit.
IMAGE_TAG=latest
