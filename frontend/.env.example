# Địa chỉ API khi phát triển. Khi site và API cùng một địa chỉ (Docker, sau nginx) thì dùng /
VITE_API_BASE_URL=http://localhost:5045
# OAuth Client ID của Google (Google Cloud Console → APIs & Services → Credentials). Để trống thì không hiện nút
# "Đăng nhập bằng Google". Phải giống GoogleAuth__ClientId của API.
VITE_GOOGLE_CLIENT_ID=
