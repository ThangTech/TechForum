# Biến môi trường cho API trên Render (Environment → Add from .env).
# Chép file này ra chỗ khác, điền các phần <...> rồi dán vào Render. KHÔNG commit bản đã điền.
# Cột "lấy từ": tên biến trong file .env ở máy (Docker) có cùng giá trị, hoặc nơi lấy giá trị mới.

# ---- Chạy API ----
# Bản thật: tắt trang lỗi chi tiết, bắt buộc HTTPS cho link trong email.
ASPNETCORE_ENVIRONMENT=Production
# Cổng API lắng nghe trong image (backend/Dockerfile: EXPOSE 8080). Render chuyển lưu lượng vào cổng này.
PORT=8080

# ---- Database: Azure SQL ----
# Lấy từ: Azure → SQL database TechForum → Connection strings → ADO.NET (SQL authentication).
# <user> là "Server admin login" lúc tạo server (không phải email). Phần retry giúp chờ database free thức dậy (~1 phút).
ConnectionStrings__DefaultConnection=Server=tcp:techforum-thang.database.windows.net,1433;Initial Catalog=TechForum;User ID=<user>;Password=<password>;Encrypt=True;TrustServerCertificate=False;Connect Timeout=120;ConnectRetryCount=6;ConnectRetryInterval=10
# Tự tạo bảng / cập nhật migration mỗi lần API khởi động.
Database__MigrateOnStartup=true
# Thêm 3 chuyên mục, 4 thẻ và 2 bài mẫu khi bảng còn trống; chạy lại không bị nhân đôi nên để true luôn cũng được.
Database__SeedDemoData=true

# ---- Đăng nhập ----
# KHÁC với JWT_SIGNING_KEY trong .env. Tạo mới bằng PowerShell:
#   [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(48))
# Đổi khóa này thì mọi người đang đăng nhập bị đăng xuất.
Jwt__SigningKey=<khóa ngẫu nhiên mới>
# Lấy từ: GOOGLE_CLIENT_ID trong .env (không phải bí mật). Để trống thì tắt nút đăng nhập Google.
GoogleAuth__ClientId=1057663481302-m2uepta1i14t49i0ep82o4r8d4173jtb.apps.googleusercontent.com

# ---- Đứng sau proxy ----
# Đọc IP thật của người dùng từ X-Forwarded-For (cho giới hạn gửi email, đăng bài).
ReverseProxy__Enabled=true
# 2 proxy đứng trước API: Vercel rồi proxy của Render (xem docs/DEPLOY.md).
ReverseProxy__ForwardLimit=2

# ---- Log ----
# Không ghi từng câu SQL vào log (đỡ rối và đỡ lộ dữ liệu).
Logging__LogLevel__Microsoft.EntityFrameworkCore.Database.Command=Warning

# ---- Ảnh, video: Cloudinary ----
# Lấy từ: CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET trong .env.
Cloudinary__CloudName=<CLOUDINARY_CLOUD_NAME>
Cloudinary__ApiKey=<CLOUDINARY_API_KEY>
Cloudinary__ApiSecret=<CLOUDINARY_API_SECRET>
# Lấy từ: CLOUDINARY_IMAGE_MODERATION. aws_rek = AI kiểm duyệt ảnh; để trống nếu chưa bật add-on.
Cloudinary__ImageModeration=aws_rek

# ---- Email: Mailjet ----
# Lấy từ: SMTP_HOST.
RecoveryEmail__Host=in-v3.mailjet.com
# KHÁC .env (587): Render miễn phí chặn cổng 25, 465, 587 nên dùng 2525.
RecoveryEmail__Port=2525
# Lấy từ: SMTP_USE_TLS. Cổng 2525 dùng STARTTLS.
RecoveryEmail__UseTls=true
# Lấy từ: SMTP_USERNAME / SMTP_PASSWORD = Primary API Key / Secret Key của tài khoản Mailjet CHÍNH (không dùng sub-account).
RecoveryEmail__Username=<SMTP_USERNAME>
RecoveryEmail__Password=<SMTP_PASSWORD>
# Người gửi. Tên miền techforum.id.vn đã xác minh trên Mailjet (SPF, DKIM trong DNS của iNET) nên mọi địa chỉ
# @techforum.id.vn đều gửi được. no-reply không cần là hộp thư thật.
RecoveryEmail__FromAddress=no-reply@techforum.id.vn
# Người dùng bấm "Trả lời" thì thư về đây: hộp thư thật của iNET (đọc ở mail.techforum.id.vn).
RecoveryEmail__ReplyToAddress=contact@techforum.id.vn
# Địa chỉ trang web, dùng để tạo link trong email. Phải là https. Sửa lại khi biết địa chỉ Vercel thật / có tên miền.
RecoveryEmail__FrontendUrl=https://techforum.vercel.app

# ---- Từ cấm ----
# File thật thêm ở Render → Secret Files với tên banned-words.txt (nội dung lấy từ file BANNED_WORDS_FILE trỏ tới).
# Chỉ nạp khi bảng từ cấm còn trống.
BannedWords__SeedFile=/etc/secrets/banned-words.txt
